POSTGRES_USER=platform
POSTGRES_PASSWORD=platform_secret
POSTGRES_DB=platform_db
# ENVIRONMENT: development | staging | production. Only "production" requires
# a Bearer token on every request (otherwise anonymous calls run as dev-user).
# Only "development" allows the placeholder secrets below; with any other value
# the services refuse to start while a secret below is a placeholder or shorter than 32
# characters: api-gateway, storage-service and ssh-executor check JWT_SECRET,
# ssh-executor also checks SSH_CRED_KEY.
ENVIRONMENT=development
# Signs user JWTs and internal service-to-service JWTs. Outside development
# this MUST be a long random string (32+ chars), e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_in_production
DATABASE_URL=postgresql://platform:platform_secret@postgres:5432/platform_db
# At-rest encryption key for stored SSH credentials (ssh-executor).
# Outside development this MUST be a long random string (32+ chars).
SSH_CRED_KEY=change_me_ssh_cred_key
# Browser origins allowed by the APIs. Must be a JSON list. The dashboard at
# :3000 proxies /api same-origin through nginx, so this only matters for
# direct browser calls to the gateway.
CORS_ORIGINS=["http://localhost:3000"]

# --- Optional Spark + Ray engine (master only) -----------------------------
# Turn it on with `make enable-spark-ray` or VS Code's "Enable Spark + Ray
# Engine" (they set WITH_SPARK_RAY=true in ./.env next to docker-compose.yml,
# not in this file). Worker nodes never need it. The settings below are optional.
# Use an existing Spark cluster instead of the master's own cores:
# SPARK_MASTER_URL=spark://spark-master:7077
# SPARK_DRIVER_MEMORY=2g
# Use an existing Ray cluster instead of starting Ray on the master:
# RAY_ADDRESS=ray://ray-head:10001
# Rows a Spark MLlib model may train on (worker training is capped by MAX_TRAIN_ROWS):
# MAX_SPARK_ROWS=5000000

# --- Dataset storage ---------------------------------------------------------
# Datasets are stored as files in the `datasets` Docker volume. To use HDFS
# instead, start with `make up-hdfs` (it sets STORAGE_BACKEND=hdfs); to move
# datasets from an older HDFS install, run `make migrate-datasets`.
# MAX_UPLOAD_SIZE_BYTES=10737418240      # 10 GB per dataset
# MIN_FREE_DISK_BYTES=536870912          # refuse uploads below 512 MB free
# HDFS_WEBHDFS_URL=http://namenode:9870  # only with STORAGE_BACKEND=hdfs
# HDFS_USER=hadoop
