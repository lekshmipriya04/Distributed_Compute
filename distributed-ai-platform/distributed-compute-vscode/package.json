      },
      {
        "command": "distributedCompute.showDiagnostics",
        "title": "Show Diagnostics",
        "category": "Distributed Compute"
      }
    ],
    "configuration": {
      "title": "Distributed Compute",
      "properties": {
        "distributedCompute.masterUrl": {
          "type": "string",
          "default": "http://localhost:8090",
          "description": "Base URL of the extension gateway. The default is a master started on this machine with docker compose. Use https:// for remote hosts; http:// is allowed only for local or LAN hosts."
        },
        "distributedCompute.autoConnect": {
          "type": "boolean",
          "default": false,
          "description": "Attempt to connect to the configured master on activation."
        },
        "distributedCompute.refreshIntervalSeconds": {
          "type": "number",
          "default": 15,
          "minimum": 5,
          "description": "Polling interval for platform state (minimum 5s)."
        },
        "distributedCompute.defaultRuntime": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.+-]{0,31}$",
          "default": "python",
          "description": "Default runtime id for new jobs (any id from GET /runtimes that is detected on your nodes, e.g. python, bash, node, go)."
        },
        "distributedCompute.defaultTimeoutSeconds": {
          "type": "number",
          "default": 600,
          "minimum": 1,
          "description": "Default job timeout in seconds."
        },
        "distributedCompute.executionPolicy": {
          "type": "string",
          "enum": [
            "safe_background",
            "balanced",
            "max_available"
          ],
          "enumDescriptions": [
            "Low priority; never starve the worker owner",
            "Normal priority within the allocated slice",
            "Use the full allocated slice"
          ],
          "default": "safe_background",
          "description": "How hard submitted executions may use each worker's lent slice."
        },
        "distributedCompute.showNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show job lifecycle notifications."
        },
        "distributedCompute.logLevel": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug"
          ],
          "default": "info",
          "description": "Diagnostics Output Channel verbosity."
        },
        "distributedCompute.training.defaultEngine": {
          "type": "string",
          "enum": [
            "python",
            "spark_ray"
          ],
          "enumDescriptions": [
            "Pure Python: nothing extra to install",
            "Apache Spark + Ray on the master (installed on request)"
          ],
          "default": "python",
          "description": "Engine offered first by Submit Training Job."
        },
        "distributedCompute.training.defaultRounds": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "description": "Federated rounds (the master averages the model after each)."
        },
        "distributedCompute.training.defaultEpochs": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "Epochs each worker runs per round."
        },
        "distributedCompute.training.defaultLearningRate": {
          "type": "number",
          "default": 0.01,
          "exclusiveMinimum": 0,
          "description": "Learning rate for built-in and custom models."
        },
        "distributedCompute.autoStartPlatform": {
          "type": "boolean",
          "default": true,
          "description": "After the platform has been set up on this computer, start its Docker containers (and Docker Desktop, if needed) when VS Code opens, then connect."
        },
        "distributedCompute.platformPath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Folder with the platform's docker-compose.yml. Used to install Spark + Ray on a master running on this machine; found automatically when empty."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "distributed.json",
        "url": "./schemas/distributed.schema.json"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "distributedCompute.viewNode",
          "when": "false"
        },
        {
          "command": "distributedCompute.configureSlice",
          "when": "false"
        },
        {
          "command": "distributedCompute.downloadModel",
          "when": "false"
        },
        {
          "command": "distributedCompute.showTrainingRun",
          "when": "false"
        },
        {
          "command": "distributedCompute.deleteTrainingRun",
          "when": "false"
        },
        {
          "command": "distributedCompute.trainWithModelFile",
          "when": "editorLangId == python"
        }
      ],
      "view/title": [
        {
          "command": "distributedCompute.refreshNodes",
          "when": "view == distributedCompute.nodes",
          "group": "navigation"
        },
        {
          "command": "distributedCompute.addNode",
          "when": "view == distributedCompute.nodes",
          "group": "navigation"
        },
        {
          "command": "distributedCompute.runDistributed",
          "when": "view == distributedCompute.jobs",
          "group": "navigation@1"
        },
        {
          "command": "distributedCompute.refreshState",
          "when": "view == distributedCompute.jobs",
          "group": "navigation"
        },
        {
          "command": "distributedCompute.refreshState",
          "when": "view == distributedCompute.executions",
          "group": "navigation"
        },
        {
          "command": "distributedCompute.submitTraining",
          "when": "view == distributedCompute.training",
          "group": "navigation@1"
        },
        {
          "command": "distributedCompute.runTrainingAgain",
          "when": "view == distributedCompute.training",
          "group": "navigation@2"
        },
        {
          "command": "distributedCompute.refreshTraining",
          "when": "view == distributedCompute.training",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "distributedCompute.viewNode",
          "when": "view == distributedCompute.nodes && viewItem =~ /^node:/",
          "group": "inline"
        },
        {
          "command": "distributedCompute.configureSlice",
          "when": "view == distributedCompute.nodes && viewItem =~ /^node:/"
        },
        {
          "command": "distributedCompute.drainNode",
          "when": "view == distributedCompute.nodes && viewItem =~ /^node:(online|busy|degraded)$/"
        },
        {
          "command": "distributedCompute.resumeNode",
          "when": "view == distributedCompute.nodes && viewItem == node:draining"
        },
        {
          "command": "distributedCompute.testNode",
          "when": "view == distributedCompute.nodes && viewItem =~ /^node:/",
          "group": "1_node@1"
        },
        {
          "command": "distributedCompute.refreshNodeCapabilities",
          "when": "view == distributedCompute.nodes && viewItem =~ /^node:/",
          "group": "1_node@2"
        },
        {
          "command": "distributedCompute.rotateNodeKey",
          "when": "view == distributedCompute.nodes && viewItem =~ /^node:/",
          "group": "1_node@3"
        },
        {
          "command": "distributedCompute.removeNode",
          "when": "view == distributedCompute.nodes && viewItem =~ /^node:/",
          "group": "9_danger@1"
        },
        {
          "command": "distributedCompute.viewLogs",
          "when": "viewItem =~ /^execution:/"
        },
        {
          "command": "distributedCompute.cancelExecution",
          "when": "viewItem =~ /^execution:.*:active$/"
        },
        {
          "command": "distributedCompute.retryExecution",
          "when": "viewItem =~ /^execution:.*:terminal$/"
        },
        {
          "command": "distributedCompute.retrieveResults",
          "when": "viewItem =~ /^execution:.*:terminal$/"
        },
        {
          "command": "distributedCompute.downloadModel",
          "when": "view == distributedCompute.training && viewItem =~ /^training:completed:/",
          "group": "inline"
        },
        {
          "command": "distributedCompute.downloadModel",
          "when": "view == distributedCompute.training && viewItem =~ /^training:completed:/",
          "group": "1_run@1"
        },
        {
          "command": "distributedCompute.showTrainingRun",
          "when": "view == distributedCompute.training && viewItem =~ /^training:/",
          "group": "1_run@2"
        },
        {
          "command": "distributedCompute.deleteTrainingRun",
          "when": "view == distributedCompute.training && viewItem =~ /^training:.*:terminal:/",
          "group": "2_danger@1"
        }
      ],
      "explorer/context": [
        {
          "command": "distributedCompute.trainOnDataset",
          "when": "resourceExtname =~ /^\\.(csv|json|jsonl|parquet)$/",
          "group": "distributedCompute@1"
        },
        {
          "command": "distributedCompute.trainWithModelFile",
          "when": "resourceLangId == python",
          "group": "distributedCompute@2"
        }
      ],
      "editor/context": [
        {
          "command": "distributedCompute.runPythonFile",
          "when": "resourceLangId == python",
          "group": "distributedCompute@1"
        },
        {
          "command": "distributedCompute.runWithRuntime",
          "group": "distributedCompute@2"
        },
        {
          "command": "distributedCompute.runDistributed",
          "group": "distributedCompute@2"
        },
        {
          "command": "distributedCompute.trainWithModelFile",
          "when": "resourceLangId == python",
          "group": "distributedCompute@3"
        }
      ],
      "editor/title/run": [
        {
          "command": "distributedCompute.runPythonFile",
          "when": "resourceLangId == python",
          "group": "1_run@1"
        },
        {
          "command": "distributedCompute.runDistributed",
          "group": "1_run@2"
        }
      ]
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "compile": "npm run typecheck && node ./esbuild.js",
    "build:prod": "npm run clean && npm run typecheck && node ./esbuild.js --production",
    "watch": "node ./esbuild.js --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p ./",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:vscode": "npm run compile && node ./e2e/vscode/run.js",
    "docs:screenshots": "npm run compile && node ./e2e/screenshots/capture.mjs",
    "vscode:prepublish": "npm run build:prod",
    "package": "vsce package --baseContentUrl https://github.com/lekshmipriya04/Distributed_Compute/blob/main/distributed-ai-platform/distributed-compute-vscode --baseImagesUrl https://github.com/lekshmipriya04/Distributed_Compute/raw/main/distributed-ai-platform/distributed-compute-vscode"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "^2.26.0",
    "esbuild": "^0.21.0",
    "eslint": "^9.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^1.6.0"
  }
}