{
  "name": "distributed-compute",
  "displayName": "Distributed Compute",
  "description": "Run code and train models on your own machines over SSH, entirely from VS Code: one-click local setup, add and manage workers, run any language in parallel with live output, and train built-in, custom or Spark models.",
  "version": "1.0.0",
  "publisher": "aaron43210",
  "author": "AARON R, M R LEKSHMI PRIYA, ALEENA VJ",
  "contributors": [
    "AARON R",
    "M R LEKSHMI PRIYA",
    "ALEENA VJ"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lekshmipriya04/Distributed_Compute.git",
    "directory": "distributed-ai-platform/distributed-compute-vscode"
  },
  "bugs": {
    "url": "https://github.com/lekshmipriya04/Distributed_Compute/issues"
  },
  "homepage": "https://github.com/lekshmipriya04/Distributed_Compute#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Machine Learning",
    "Visualization"
  ],
  "keywords": [
    "distributed",
    "compute",
    "ssh",
    "remote execution",
    "machine learning"
  ],
  "icon": "media/icons/distributed-compute.png",
  "activationEvents": [
    "onStartupFinished",
    "onView:distributedCompute.nodes",
    "onView:distributedCompute.jobs",
    "onView:distributedCompute.executions",
    "onView:distributedCompute.training"
  ],
  "main": "./dist/extension.js",
  "pricing": "Free",
  "galleryBanner": {
    "color": "#1e3a8a",
    "theme": "dark"
  },
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode the master URL and platform folder from workspace settings are ignored, and no docker-compose.yml from the workspace is run.",
      "restrictedConfigurations": [
        "distributedCompute.masterUrl",
        "distributedCompute.platformPath"
      ]
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "distributedCompute",
          "title": "Distributed Compute",
          "icon": "media/icons/activity.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "distributedCompute.nodes",
        "contents": "Not connected to a master.\n[$(rocket) Set Up Platform on This Computer](command:distributedCompute.setUpPlatform)\nDocker builds and starts everything, then VS Code connects. Nothing to type.\n[Connect to Another Master](command:distributedCompute.configureMaster)",
        "when": "!distributedCompute.connected"
      },
      {
        "view": "distributedCompute.nodes",
        "contents": "No worker machines yet. A worker needs only SSH and Python; nothing is installed on it.\n[$(add) Add Compute Node](command:distributedCompute.addNode)",
        "when": "distributedCompute.connected"
      },
      {
        "view": "distributedCompute.jobs",
        "contents": "No runs yet. Open a file and run it on your workers.\n[$(run-all) Run File in Parallel](command:distributedCompute.runDistributed)",
        "when": "distributedCompute.connected"
      },
      {
        "view": "distributedCompute.executions",
        "contents": "Each run's tasks appear here. Click one to see its output.",
        "when": "distributedCompute.connected"
      },
      {
        "view": "distributedCompute.training",
        "contents": "No training runs yet.\n[$(play) Submit Training Job](command:distributedCompute.submitTraining)",
        "when": "distributedCompute.connected"
      },
      {
        "view": "distributedCompute.jobs",
        "contents": "Connect to see your runs.",
        "when": "!distributedCompute.connected"
      },
      {
        "view": "distributedCompute.executions",
        "contents": "Connect to see your runs.",
        "when": "!distributedCompute.connected"
      },
      {
        "view": "distributedCompute.training",
        "contents": "Connect to train models.",
        "when": "!distributedCompute.connected"
      }
    ],
    "walkthroughs": [
      {
        "id": "distributedCompute.getStarted",
        "title": "Get Started with Distributed Compute",
        "description": "Run code and train models on your own machines, in three clicks.",
        "steps": [
          {
            "id": "setUp",
            "title": "Start the platform",
            "description": "One click. VS Code checks Docker (and starts Docker Desktop), downloads the platform if needed, starts it and connects.\n[Set Up Platform](command:distributedCompute.setUpPlatform)",
            "media": {
              "markdown": "media/walkthrough/setup.md"
            },
            "completionEvents": [
              "onContext:distributedCompute.connected"
            ]
          },
          {
            "id": "addWorker",
            "title": "Add a worker machine",
            "description": "Enter the machine's address, user and SSH password, once. VS Code checks its host key, installs a restricted key and detects its hardware.\n[Add Compute Node](command:distributedCompute.addNode)",
            "media": {
              "markdown": "media/walkthrough/workers.md"
            },
            "completionEvents": [
              "onCommand:distributedCompute.addNode"
            ]
          },
          {
            "id": "run",
            "title": "Run code or train a model",
            "description": "Open any file and run it on your workers, as one task or many in parallel, or train a model. Output streams in live.\n[Run File in Parallel](command:distributedCompute.runDistributed)\n[Train a Model](command:distributedCompute.submitTraining)",
            "media": {
              "markdown": "media/walkthrough/run.md"
            },
            "completionEvents": [
              "onCommand:distributedCompute.runDistributed",
              "onCommand:distributedCompute.runWithRuntime",
              "onCommand:distributedCompute.submitTraining"
            ]
          }
        ]
      }
    ],
    "views": {
      "distributedCompute": [
        {
          "id": "distributedCompute.nodes",
          "name": "Compute Nodes"
        },
        {
          "id": "distributedCompute.jobs",
          "name": "Jobs"
        },
        {
          "id": "distributedCompute.executions",
          "name": "Executions"
        },
        {
          "id": "distributedCompute.training",
          "name": "Training Runs"
        }
      ]
    },
