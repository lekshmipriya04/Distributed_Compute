{
  "name": "distributed-ai-platform-frontend",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e:serve": "node e2e/serve.mjs",
    "e2e:stop": "node e2e/serve.mjs --stop",
    "test:e2e": "playwright test --project=flows-chromium --project=chromium --project=firefox --project=webkit --project=mobile-android --project=mobile-ios",
    "docs:screenshots": "playwright test --project=docs"
  },
  "dependencies": {
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.0",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.2.2",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
